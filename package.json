{
  "name": "reaplift-call-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @reaplift/calls-server --filter @reaplift/calls-web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @reaplift/calls-shared build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:int": "pnpm --filter @reaplift/calls-server test:int",
    "migrate": "pnpm --filter @reaplift/calls-server migrate",
    "db:up": "docker compose -f infra/compose.dev.yml up -d --wait mariadb",
    "db:down": "docker compose -f infra/compose.dev.yml down",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
