# Copy to .env and fill in. Never commit .env.

# Which part of the server to start: api | migrate
MODE=api
# Blank means 3100 (3000 is left free for reaplift-bsp)
PORT=
LOG_LEVEL=info

# Local default matches infra/compose.dev.yml: MariaDB 11.8 on port 3307 (D10)
DATABASE_URL=mysql://calls:calls@localhost:3307/calls
# Integration tests empty this database. Blank means calls_test on the local MariaDB.
TEST_DATABASE_URL=

# Set by the deploy pipeline; leave blank locally ("dev" is used)
APP_VERSION=

# M1 login. PANEL_ORIGIN blank means http://localhost:5174. SESSION_COOKIE_SECURE blank means true;
# set it to false for local development over plain http.
PANEL_ORIGIN=
SESSION_COOKIE_SECURE=

# M1 phones. PUBLIC_BASE_URL is the address phones reach and goes into the pairing QR code; locally use the
# laptop's Wi-Fi address, e.g. http://192.168.1.10:3100 (`ipconfig getifaddr en0`). Blank means http://localhost:3100.
# APK_DIR holds latest.apk for the install page (blank means ./apk). Blank hours and days mean 24 and 7.
PUBLIC_BASE_URL=
APK_DIR=
PAIRING_CODE_HOURS=
INITIAL_SYNC_DAYS=
# The built panel to serve from the server itself (e.g. ../web/dist, relative to apps/server). Blank locally,
# where `pnpm dev` serves the panel on 5174.
PANEL_DIR=

# Call recordings (M6): Cloudflare R2 in production. Locally, SeaweedFS from infra/compose.dev.yml (`s3`):
# S3_ENDPOINT=http://localhost:9010, S3_BUCKET=reaplift-call-recordings, any non-blank key and secret.
# All blank means recordings are off; phones keep trying later.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
