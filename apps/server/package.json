{
  "name": "@reaplift/calls-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/main.ts --mode=migrate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'test/**/*.int.test.ts'",
    "test:int": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs run --no-file-parallelism test/*.int.test.ts",
    "cli": "tsx --env-file-if-exists=../../.env src/cli.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@reaplift/calls-shared": "workspace:*",
    "cookie": "^1.1.1",
    "fastify": "^5.12.8",
    "kysely": "^0.28.19",
    "mysql2": "3.11.5",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
